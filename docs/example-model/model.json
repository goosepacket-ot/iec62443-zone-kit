  "assessment": [
    {
      "fr": "FR1",
      "title": "Identification & authentication control",
      "description": "Every human and device on the zone is identified and authenticated before it can act.",
      "status": "review",
      "note": "Confirm device/user authentication on each zone (no shared accounts, no default credentials, SNMPv3 not v1/v2c)."
    },
    {
      "fr": "FR2",
      "title": "Use control",
      "description": "Authenticated users/devices are restricted to the actions (read / write / control) they are permitted.",
      "status": "review",
      "note": "Confirm write/control is allow-listed per source in the conduit rules (e.g. only the SCADA zone may write to controllers)."
    },
    {
      "fr": "FR3",
      "title": "System integrity",
      "description": "Integrity of data and of the control logic is protected in transit and at rest.",
      "status": "review",
      "note": "Confirm integrity controls on control logic and GOOSE/SV where applicable (IEC 62351), and change management on PLC programs."
    },
    {
      "fr": "FR4",
      "title": "Data confidentiality",
      "description": "Information at rest and in transit is protected from disclosure where required.",
      "status": "partial",
      "note": "Some flows use encrypted transports."
    },
    {
      "fr": "FR5",
      "title": "Restricted data flow",
      "description": "The network is segmented into zones and conduits; only the approved flows cross them.",
      "status": "partial",
      "note": "6 zones and 5 conduits defined; confirm the firewall enforces exactly these flows with a default-deny."
    },
    {
      "fr": "FR6",
      "title": "Timely response to events",
      "description": "Security events are detected, logged and responded to.",
      "status": "review",
      "note": "Confirm logging/monitoring exists at each conduit (firewall logs, OT IDS) and is reviewed."
    },
    {
      "fr": "FR7",
      "title": "Resource availability",
      "description": "The control system remains available under load, fault and attack.",
      "status": "review",
      "note": "Confirm redundancy / DoS resistance appropriate to the highest SL-T zone."
    }
